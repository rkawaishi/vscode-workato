{
  "permissions": {
    "allow": [
      "Bash(npm run compile)",
      "Bash(npm run watch)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(code --extensionDevelopmentPath=*)",
